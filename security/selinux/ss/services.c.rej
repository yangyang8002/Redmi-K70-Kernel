+				      struct context *scontext,
+				      struct context *tcontext,
+				      u16 tclass,
+				      struct av_decision *avd,
+				      struct extended_perms *xperms)
+{
+	context_struct_compute_av(policydb, scontext, tcontext, tclass, avd, xperms);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
