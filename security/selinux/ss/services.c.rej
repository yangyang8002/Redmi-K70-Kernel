@@ -527,6 +527,18 @@ static void security_dump_masked_av(struct policydb *policydb,
 	kfree(scontext_name);
 }
 
+#ifdef CONFIG_KSU_SUSFS
+void security_dump_masked_av_fn(struct policydb *policydb,
+				    struct context *scontext,
+				    struct context *tcontext,
+				    u16 tclass,
+				    u32 permissions,
+				    const char *reason)
+{
+	security_dump_masked_av(policydb, scontext, tcontext, tclass, permissions, reason);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
+
 /*
  * security_boundary_permission - drops violated permissions
